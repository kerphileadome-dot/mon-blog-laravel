# Copiez ce fichier en « google.local.env » (non versionné).
# Utilisez les MÊMES identifiants que sur Railway (Google Cloud Console).
#
# Dans Google Cloud Console → Identifiants OAuth, ajoutez AUSSI les URI locaux :
#   Origine JavaScript : http://127.0.0.1  et  http://localhost
#   URI de redirection : http://127.0.0.1/mon_blog/public/auth/google/callback
#   (Google refuse les domaines .test comme mon-blog.test)
#
# Puis : powershell -ExecutionPolicy Bypass -File scripts/setup-google-oauth.ps1

GOOGLE_CLIENT_ID=838121924906-8qr1ttd3hje99j24ka5pdievaohpvgsh.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-secret-google
