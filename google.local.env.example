# Copiez ce fichier en « google.local.env » (non versionné).
# Utilisez les MÊMES identifiants que sur Railway (Google Cloud Console).
#
# Dans Google Cloud Console → Identifiants OAuth, ajoutez aussi :
#   Origine JavaScript : http://mon-blog.test:8080
#   URI de redirection : http://mon-blog.test:8080/auth/google/callback
#
# Puis : powershell -ExecutionPolicy Bypass -File scripts/setup-local-env.ps1

GOOGLE_CLIENT_ID=votre-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=votre-secret-google
